    @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;500;700&display=swap');

:root {
    --cyan: #22d3ee; --purple: #a855f7; --rose: #f43f5e; --bg: #030303;
}

* { margin: 0; padding: 0; box-sizing: border-box; scroll-behavior: smooth; }
body { background: var(--bg); color: #fff; font-family: 'Space Grotesk', sans-serif; overflow-x: hidden; }

/* COSMIC SYSTEM */
.galaxy-bg {
    position: fixed; inset: 0; z-index: -10;
    background: radial-gradient(circle at center, #0a1122 0%, #000 100%);
}

.nebula {
    position: fixed; inset: 0; z-index: -9;
    background: 
        radial-gradient(circle at 10% 20%, rgba(244, 63, 94, 0.05) 0%, transparent 40%),
        radial-gradient(circle at 90% 80%, rgba(34, 211, 238, 0.05) 0%, transparent 40%);
    filter: blur(100px);
}

.stars {
    position: fixed; inset: 0; z-index: -8;
    background-image: radial-gradient(white 1px, transparent 1px);
    background-size: 100px 100px;
    opacity: 0.1;
}

/* METEORS */
.meteors { position: fixed; width: 100%; height: 100vh; z-index: -7; overflow: hidden; pointer-events: none; }
.meteors span {
    position: absolute; top: -10%; left: 70%; width: 2px; height: 2px; background: #fff;
    animation: meteor 10s linear infinite;
}
@keyframes meteor {
    0% { transform: rotate(315deg) translateX(0); opacity: 0; }
    10% { opacity: 1; }
    100% { transform: rotate(315deg) translateX(-1000px); opacity: 0; }
}

/* NAVIGATION */
.glass-nav {
    position: fixed; top: 0; width: 100%; z-index: 100;
    background: rgba(0,0,0,0.5); backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(255,255,255,0.05);
    padding: 1.5rem 4rem; display: flex; justify-content: space-between; align-items: center;
}
.logo { font-weight: 700; letter-spacing: 0.3em; font-size: 0.8rem; }
.nav-btn {
    text-decoration: none; color: #64748b; font-size: 0.7rem; 
    padding: 0.5rem 1rem; border-radius: 50px; transition: 0.3s;
    text-transform: uppercase; letter-spacing: 0.15em;
}
.nav-btn:hover { color: #fff; background: rgba(255,255,255,0.05); }

/* SECTIONS & CARDS */
section { min-height: 100vh; padding: 140px 10%; display: flex; flex-direction: column; justify-content: center; position: relative; }
.chapter-label { position: absolute; top: 100px; left: 10%; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.4em; color: #475569; }

.glass-card { 
    background: rgba(255, 255, 255, 0.02); 
    backdrop-filter: blur(20px); 
    border: 1px solid rgba(255, 255, 255, 0.08); 
    border-radius: 32px; 
    padding: 4rem; 
    transition: 0.5s cubic-bezier(0.23, 1, 0.32, 1);
}
.glass-card:hover { transform: translateY(-10px); background: rgba(255, 255, 255, 0.04); }

/* VISUAL PLACEHOLDERS */
.visual-placeholder { height: 350px; border-radius: 20px; overflow: hidden; background: #000; display: flex; align-items: center; justify-content: center; }
.hello-text { font-size: 5rem; font-weight: 700; color: #fff; animation: pulse 3s infinite; }
@keyframes pulse { 0%, 100% { opacity: 0.5; } 50% { opacity: 1; } }

/* FOOTER */
.footer { padding: 4rem; text-align: center; font-size: 0.6rem; letter-spacing: 0.6em; color: #475569; border-top: 1px solid rgba(255,255,255,0.05); }
