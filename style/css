@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;500;700&display=swap');

:root {
    --cyan: #22d3ee;
    --purple: #a855f7;
    --emerald: #10b981;
    --rose: #f43f5e;
}

body {
    background-color: #030303;
    color: #fafafa;
    font-family: 'Space Grotesk', sans-serif;
    margin: 0;
    overflow-x: hidden;
}

/* Multi-Colored Neural Signals */
.signal {
    position: absolute;
    height: 2px;
    width: 200px;
    opacity: 0.6;
    filter: blur(1px);
    animation: travel 8s linear infinite;
}

.signal-cyan { background: linear-gradient(90deg, transparent, var(--cyan), transparent); }
.signal-purple { background: linear-gradient(90deg, transparent, var(--purple), transparent); }
.signal-emerald { background: linear-gradient(90deg, transparent, var(--emerald), transparent); }

@keyframes travel {
    0% { transform: translateX(-100vw); opacity: 0; }
    50% { opacity: 1; }
    100% { transform: translateX(100vw); opacity: 0; }
}

/* Animated Nav Buttons */
.nav-btn {
    position: relative;
    padding: 0.5rem 1rem;
    transition: all 0.3s ease;
    border: 1px solid transparent;
    border-radius: 8px;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
}

.nav-btn:hover {
    border-color: var(--cyan);
    color: var(--cyan);
    background: rgba(34, 211, 238, 0.1);
    box-shadow: 0 0 15px rgba(34, 211, 238, 0.3);
    transform: translateY(-2px);
}

.glass-card {
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(15px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 24px;
}
