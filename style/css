@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;500;700&display=swap');

:root {
    --cyan: #22d3ee; --purple: #a855f7; --emerald: #10b981; 
    --rose: #f43f5e; --amber: #fbbf24; --bg: #030303;
}

* { margin: 0; padding: 0; box-sizing: border-box; scroll-behavior: smooth; }

body { 
    background: var(--bg); 
    color: #fff; 
    font-family: 'Space Grotesk', sans-serif; 
    overflow-x: hidden; 
}

/* CLEAN COSMIC SYSTEM */
.galaxy-bg {
    position: fixed; inset: 0; z-index: -10;
    background: radial-gradient(circle at center, #0a1122 0%, #000 100%);
}

/* NEBULA CLOUDS - Very Subtle */
.nebula {
    position: fixed; inset: 0; z-index: -9;
    background: 
        radial-gradient(circle at 20% 30%, rgba(34, 211, 238, 0.08) 0%, transparent 40%),
        radial-gradient(circle at 80% 70%, rgba(168, 85, 247, 0.08) 0%, transparent 40%);
    filter: blur(80px);
}

/* MILKY WAY STARS */
.stars {
    position: fixed; inset: 0; z-index: -8;
    background-image: 
        radial-gradient(white 1px, transparent 1px),
        radial-gradient(rgba(255,255,255,0.5) 1.5px, transparent 1.5px);
    background-size: 80px 80px, 200px 200px;
    opacity: 0.15;
}

/* METEORS - Clean streaks */
.meteors { position: fixed; width: 100%; height: 100vh; z-index: -7; overflow: hidden; pointer-events: none; }
.meteors span {
    position: absolute; top: -10%; left: 80%; width: 2px; height: 2px;
    background: #fff; border-radius: 50%;
    box-shadow: 0 0 10px #fff;
    animation: meteor 8s linear infinite;
}
.meteors span::before {
    content: ''; position: absolute; width: 150px; height: 1px;
    background: linear-gradient(90deg, #fff, transparent);
    transform: translateY(-50%);
}
@keyframes meteor {
    0% { transform: rotate(315deg) translateX(0); opacity: 0; }
    10% { opacity: 1; }
    100% { transform: rotate(315deg) translateX(-1500px); opacity: 0; }
}

/* CONTENT BOXES - To clear up the "messy" look */
section { 
    min-height: 100vh; 
    padding: 140px 10%; 
    position: relative; 
    z-index: 1; /* Keeps content above background */
}

.glass-card { 
    background: rgba(0, 0, 0, 0.5); 
    backdrop-filter: blur(15px); 
    border: 1px solid rgba(255, 255, 255, 0.1); 
    border-radius: 24px; 
    padding: 3rem; 
}
