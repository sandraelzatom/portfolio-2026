@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;500;700&display=swap');

:root {
    --cyan: #22d3ee;
    --purple: #a855f7;
    --emerald: #10b981;
    --rose: #f43f5e;
    --amber: #fbbf24;
}

* { margin: 0; padding: 0; box-sizing: border-box; scroll-behavior: smooth; }

body {
    background-color: #030303;
    color: #fafafa;
    font-family: 'Space Grotesk', sans-serif;
    overflow-x: hidden;
}

/* Stunning Background & Neural Signals */
.galaxy-container {
    position: fixed;
    inset: 0;
    z-index: -10;
    background: radial-gradient(circle at center, #0a1122 0%, #000 100%);
    background-image: url('https://www.transparenttextures.com/patterns/stardust.png');
}

.neural-signal {
    position: absolute;
    height: 2px;
    width: 250px;
    filter: blur(2px);
    opacity: 0.6;
    animation: travel 8s linear infinite;
}

.sig-cyan { background: linear-gradient(90deg, transparent, var(--cyan), transparent); top: 15%; animation-duration: 6s; }
.sig-purple { background: linear-gradient(90deg, transparent, var(--purple), transparent); top: 40%; animation-duration: 10s; animation-delay: 2s; }
.sig-emerald { background: linear-gradient(90deg, transparent, var(--emerald), transparent); top: 65%; animation-duration: 7s; animation-delay: 4s; }
.sig-rose { background: linear-gradient(90deg, transparent, var(--rose), transparent); top: 85%; animation-duration: 9s; animation-delay: 1s; }

@keyframes travel {
    0% { left: -300px; opacity: 0; transform: scaleX(0.5); }
    50% { opacity: 1; transform: scaleX(1.3); }
    100% { left: 100vw; opacity: 0; transform: scaleX(0.5); }
}

/* Navigation System */
nav {
    position: fixed;
    top: 0; width: 100%;
    z-index: 100;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    padding: 1.5rem 3rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.nav-container { display: flex; gap: 0.5rem; }

.nav-btn {
    text-decoration: none;
    padding: 0.6rem 1.2rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #94a3b8;
    border: 1px solid transparent;
    border-radius: 50px;
    background: rgba(255, 255, 255, 0.02);
    transition: all 0.4s ease;
}

.nav-btn:hover {
    color: var(--cyan);
    border-color: var(--cyan);
    background: rgba(34, 211, 238, 0.05);
    box-shadow: 0 0 20px rgba(34, 211, 238, 0.2);
    transform: translateY(-2px);
}

/* Section Styling */
section {
    min-height: 100vh;
    padding: 120px 10%;
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.glass-card {
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(15px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 32px;
    padding: 4rem;
    transition: 0.3s;
}

.gradient-text {
    background: linear-gradient(90deg, #fff, var(--cyan), var(--purple));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.grid-2 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 3rem;
}

.section-label {
    font-size: 0.7rem;
    color: var(--cyan);
    letter-spacing: 0.4em;
    text-transform: uppercase;
    margin-bottom: 2rem;
    display: block;
}

.status-indicator {
    width: 8px; height: 8px;
    background: var(--emerald);
    border-radius: 50%;
    display: inline-block;
    margin-right: 8px;
    box-shadow: 0 0 10px var(--emerald);
}

footer {
    padding: 4rem;
    text-align: center;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    color: #444;
    font-size: 0.7rem;
    letter-spacing: 0.3em;
}
